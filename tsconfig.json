{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true
  },
  "include": [
    "server/index.ts",
    "server/**/*.ts",
    "dashboard/**/*.ts",
    "services/**/*.ts",
    "dashboard/routes/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "dashboard/src"]
}
