    "archiver": "^7.0.1",
    "cloudflared": "^0.7.1",
    "dotenv": "^16.4.0",
    "hono": "^4.12.0",
    "node-pty": "^1.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "tsx": "^4.19.0",
    "twilio": "^5.0.0",
    "unzipper": "^0.12.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/unzipper": "^0.10.11",
    "@types/ws": "^8.5.0",
    "@vitejs/plugin-react": "^5.1.4",
    "typescript": "^5.7.0",
    "vite": "^7.3.1"
  }
