  "files": [
    "bin/",
    "server/",
    "voice-server/",
    "dashboard/*.ts",
    "dashboard/dist/",
    "dashboard/routes/",
    "init/",
    "tsconfig.json"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.8",
    "@anthropic-ai/sdk": "^0.39.0",
