{
  "name": "voicecc",
  "version": "1.2.8",
  "description": "Voice Agent Platform running on Claude Code -- create and deploy conversational voice agents with ElevenLabs STT/TTS and VAD",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArthurDevel/voicecc.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/ArthurDevel/voicecc#readme",
  "bugs": {
    "url": "https://github.com/ArthurDevel/voicecc/issues"
  },
  "type": "module",
  "bin": {
    "voicecc": "bin/voicecc.js"
  },
  "scripts": {
    "start": "tsx server/index.ts",
    "dev:dashboard": "cd dashboard && npx vite",
    "build:dashboard": "cd dashboard && npx vite build",
    "prepublishOnly": "npm run build:dashboard"
